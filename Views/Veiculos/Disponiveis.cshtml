@model Projeto_AutoMobile.ViewModels.Veiculos.VeiculosDisponiveisViewModel

@{
    ViewData["Title"] = "Veículos Disponíveis";
}

<div class="container mt-4">
    <h2 class="mb-3">Veículos Disponíveis para Aluguer</h2>
    <h5 class="text-muted mb-4">Data do simulador: <strong>@Model.DataAtual.ToShortDateString()</strong></h5>

    <form asp-action="Disponiveis" method="get" class="d-flex align-items-center mb-4 p-3 border rounded bg-light">
        <label class="me-3 fw-bold">Filtrar por Tipo de Veículo:</label>
        
        <select name="tipoSelecionado" class="form-select w-auto me-3">
            <option value="Todos" selected="@(Model.TipoSelecionado == "Todos")">Mostrar Todos</option>
            <option value="Carro" selected="@(Model.TipoSelecionado == "Carro")">Carros</option>
            <option value="Mota" selected="@(Model.TipoSelecionado == "Mota")">Motas</option>
            <option value="Camioneta" selected="@(Model.TipoSelecionado == "Camioneta")">Camionetas</option>
            
            <option value="Camiao" selected="@(Model.TipoSelecionado == "Camiao")">Camiões</option>
        </select>
        
        <button type="submit" class="btn btn-primary">Aplicar Filtro</button>
    </form>

    <table class="table table-hover table-striped border">
        <thead class="table-dark">
            <tr>
                <th>ID / Matrícula</th>
                <th>Tipo de Veículo</th>
                <th>Estado Oficial</th>
                <th>Status Real (Data Simulador)</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Veiculos.Any())
            {
                <tr>
                    <td colspan="4" class="text-center p-4">Nenhum veículo disponível para o filtro selecionado.</td>
                </tr>
            }
            
            @foreach (var veiculo in Model.Veiculos)
            {
                <tr>
                    <td class="align-middle fw-bold">@veiculo.Id</td>
                    
                    <td class="align-middle">@veiculo.GetType().Name</td>
                    
                    <td class="align-middle">@veiculo.Estado</td>
                    
                    <td class="align-middle">
                        @if (veiculo.Estado != Projeto_AutoMobile.Data.Projeto_AutoMobile.EstadoVeiculo.Disponivel)
                        {
                            <span class="badge bg-success" style="font-size: 0.9em;">
                                Disponível (Data expirou a @veiculo.DataDisponibilidade.Value.ToShortDateString())
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary" style="font-size: 0.9em;">Pronto a Alugar</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>