@model IEnumerable<Projeto_AutoMobile.Data.Projeto_AutoMobile.Mota>

@{
    Layout = "_BaseIndex";
    ViewData["Title"] = "Motas";
    ViewData["DetalhesTitulo"] = "Informações Detalhadas";
    ViewData["ListaTitulo"] = "Lista de Motas";

    var selectedId = ViewBag.SelectedId as int?;
    var selectedMota = Model.FirstOrDefault(c => c.Id == selectedId);
}

@section Detalhes {
    @if (selectedMota != null)
    {
        <ul class="details-list">
            <li><strong>Matrícula:</strong>@selectedMota.Matricula</li>
            <li><strong>Estado:</strong>@selectedMota.Estado</li>
            <li><strong>Cilindrada:</strong>@selectedMota.Cilindrada</li>
            <li><strong>Preço/Dia:</strong>@selectedMota.PrecoDia.ToString("C")</li>
            <li><strong>Disponibilidade:</strong>@selectedMota.DataDisponibilidade</li>
        </ul>
    }
    else
    {
        <div class="text-center py-5">
            <p>Selecione uma mota da lista para ver os detalhes completos.</p>
        </div>
    }
}
<table class="table table-hover custom-table mb-0">
    <thead>
        <tr>
            <th>Matrícula</th>
            <th>Marca / Modelo</th>
            <th>Cilindrada</th>
            <th>Preço/Dia</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string activeClass = (item.Id == selectedId) ? "table-selected" : "";

            <tr class="@activeClass cursor-pointer" onclick="location.href='@Url.Action("Index", "Motas", new { id = item.Id })'">
                <td>@item.Matricula</td>
                <td>@item.Marca @item.Modelo</td>
                <td>@item.Cilindrada</td>
                <td>@item.PrecoDia.ToString("C")</td>
                <td class="text-end action-cell" onclick="event.stopPropagation();">
                    <partial name="_TabelaAcoes" model="item.Id" />
                </td>
            </tr>
        }
    </tbody>
</table>