@model IEnumerable<Projeto_AutoMobile.Data.Projeto_AutoMobile.Reserva>

@{
    Layout = "_BaseIndex";
    ViewData["Title"] = "Reservas";
    ViewData["DetalhesTitulo"] = "Informações Detalhadas";
    ViewData["ListaTitulo"] = "Lista de Reservas";

    var selectedId = ViewBag.SelectedId as int?;
    var selectedReserva = Model.FirstOrDefault(c => c.Id == selectedId);
}

@section Detalhes {
    @if (selectedReserva != null)
    {
        <ul class="details-list">
            <li><strong>Data de Ínicio:</strong>@selectedReserva.DataInicio</li>
            <li><strong>Data de Fim:</strong>@selectedReserva.DataFim</li>
            <li><strong>Preço/Dia:</strong>@selectedReserva.ClienteId</li>
            <li><strong>Caixa:</strong>@selectedReserva.VeiculoId</li>
            @*<li><strong>Portas:</strong> @selectedReserva.PrecoEstimado</li>*@
        </ul>
    }
    else
    {
        <div class="text-center py-5">
            <p>Selecione uma reserva da lista para ver os detalhes completos.</p>
        </div>
    }
}

<table class="table table-striped table-bordered">

    <thead class="table-dark">
        <tr>
            <th>Cliente</th>
            <th>Veículo</th>
            <th>Data Início</th>
            <th>Data Fim</th>
            <th>Preço Total</th>
            <th class="text-end">Ações</th>
            <th width="220"></th>
        </tr>
    </thead>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Cliente.Nome</td>
            <td>@item.Veiculo.Id</td>
            <td>@item.DataInicio.ToShortDateString()</td>
            <td>@item.DataFim.ToShortDateString()</td>
                @*<td>@item.PrecoEstimado €</td>*@
            <td class="text-end action-cell" onclick="event.stopPropagation();">
                <partial name="_TabelaAcoes" model="item.Id" />
            </td>
        </tr>
    }
    </tbody>

</table>