@model IEnumerable<Projeto_AutoMobile.Data.Projeto_AutoMobile.Reserva>

@{
    Layout = "_BaseIndex";
    ViewData["Title"] = "Reservas";
    ViewData["DetalhesTitulo"] = "Informações Detalhadas";
    ViewData["ListaTitulo"] = "Lista de Reservas";

    var selectedId = ViewBag.SelectedId as int?;
    var selectedReserva = Model.FirstOrDefault(c => c.Id == selectedId);
    Console.WriteLine(selectedReserva);
}

@section Detalhes {
    @if (selectedReserva != null)
    {
        <ul class="details-list">
            <li><strong>Data de Ínicio:</strong>@selectedReserva.DataInicio.ToShortDateString()</li>
            <li><strong>Data de Fim:</strong>@selectedReserva.DataFim.ToShortDateString()</li>
            <li><strong>Cliente:</strong>@selectedReserva.Cliente.Nome, @selectedReserva.Cliente.CartaConducao</li>
            <li><strong>Veiculo:</strong>@selectedReserva.Veiculo.TipoVeiculo, @selectedReserva.Veiculo.Marca, @selectedReserva.Veiculo.Matricula</li>
            <li><strong>Preço Estimado:</strong> @selectedReserva.PrecoEstimado</li>
        </ul>
    }
    else
    {
        <div class="text-center py-5">
            <p>Selecione uma reserva da lista para ver os detalhes completos.</p>
        </div>
    }
}

<table class="table table-hover custom-table mb-0">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Veículo</th>
            <th>Data Início</th>
            <th>Data Fim</th>
            <th>Preço Total</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string activeClass = (item.Id == selectedId) ? "table-selected" : "";

            <tr class="@activeClass cursor-pointer" onclick="location.href='@Url.Action("Index", "Reservas", new { id = item.Id })'"">
                <td>@item.Cliente.Nome</td>
                <td>@item.Veiculo.TipoVeiculo | @item.Veiculo.Matricula</td>
                <td>@item.DataInicio.ToShortDateString()</td>
                <td>@item.DataFim.ToShortDateString()</td>
                <td>@item.PrecoEstimado €</td>
                <td class="text-end action-cell" onclick="event.stopPropagation();">
                    <partial name="_TabelaAcoes" model="item.Id" />
                </td>
            </tr>
        }
    </tbody>
</table>