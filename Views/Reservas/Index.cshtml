@model IEnumerable<Projeto_AutoMobile.Data.Projeto_AutoMobile.Reserva>

@{
    Layout = "_BaseIndex";
    ViewData["Title"] = "Reservas";
    ViewData["DetalhesTitulo"] = "Informações Detalhadas";
    ViewData["ListaTitulo"] = "Lista de Reservas";

    var selectedId = ViewBag.SelectedId as int?;
    var selectedReserva = Model.FirstOrDefault(c => c.Id == selectedId);
    Console.WriteLine(selectedReserva);
}

@section Detalhes {
    @if (selectedReserva != null)
    {
        <ul class="details-list">
            <li>
                <strong>Estado:</strong>
                @if (selectedReserva.Concluida)
                {
                    <span class="badge bg-secondary">Devolvido</span>
                }
                else
                {

                    <span class="badge bg-success">Ativa</span>
                }
            </li>
            <li><strong>Data de Ínicio:</strong>@selectedReserva.DataInicio.ToShortDateString()</li>
            <li><strong>Data de Fim:</strong>@selectedReserva.DataFim.ToShortDateString()</li>
            <li><strong>Cliente:</strong>@selectedReserva.Cliente.Nome, @selectedReserva.Cliente.CartaConducao</li>
            <li><strong>Veículo:</strong> @selectedReserva.Veiculo.GetType().Name, @selectedReserva.Veiculo.Marca, @selectedReserva.Veiculo.Matricula</li>
            <li><strong>Preço Estimado:</strong> @selectedReserva.PrecoEstimado</li>
        </ul>
    }
    else
    {
        <div class="text-center py-5">
            <p>Selecione uma reserva da lista para ver os detalhes completos.</p>
        </div>
    }
}

<table class="table table-hover custom-table mb-0">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Veículo</th>
            <th>Data Início</th>
            <th>Data Fim</th>
            <th>Preço Total</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            // ADICIONADO: Se não estiver selecionada mas estiver concluída, fica cinzenta (table-light text-muted)
            string activeClass = (item.Id == selectedId) ? "table-selected" : (item.Concluida ? "table-light text-muted opacity-75" : "");

            <tr class="@activeClass cursor-pointer" onclick="location.href='@Url.Action("Index", "Reservas", new { id = item.Id })'">
                <td>
                    <span class="@(item.Concluida ? "text-decoration-line-through" : "")">@item.Cliente.Nome</span>
                    @if (item.Concluida)
                    {
                        <span class="badge bg-secondary ms-1">Devolvido</span>
                    }
                </td>
                <td>@item.Veiculo.GetType().Name | @item.Veiculo.Matricula</td>
                <td>@item.DataInicio.ToShortDateString()</td>
                <td>@item.DataFim.ToShortDateString()</td>
                <td>@item.PrecoEstimado €</td>
                <td class="text-end action-cell" onclick="event.stopPropagation();">
                    <div class="d-flex justify-content-end align-items-center gap-1">

                        @if (!item.Concluida)
                        {
                            <form asp-action="DevolverVeiculo" asp-route-id="@item.Id" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-success" title="Registar Devolução do Veículo">
                                    <i class="bi bi-check-circle"></i>
                                </button>
                            </form>
                        }

                        <partial name="_TabelaAcoes" model="item.Id" />
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>