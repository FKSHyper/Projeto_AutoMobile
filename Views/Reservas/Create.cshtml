@using System
@model Projeto_AutoMobile.ViewModels.Reserva.ReservaViewModel

@{
    ViewData["Title"] = "Criar Reserva";
        var hoje = DateTime.Today.ToString("yyyy-MM-dd");
}

<h1>Criar Reserva</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="DataInicio" class="control-label">
                    Data de Início
                </label>

                <input asp-for="DataInicio"
                       type="date"
                       class="form-control"
                       min="@hoje" />

                <span asp-validation-for="DataInicio"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DataFim" class="control-label">
                    Data de Fim
                </label>

                <input asp-for="DataFim"
                       type="date"
                       class="form-control"
                       min="@hoje" />

                <span asp-validation-for="DataFim"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="control-label">
                    Cliente
                </label>

                <select asp-for="ClienteId"
                        asp-items="ViewBag.Clientes"
                        class="form-control">

                    <option value="">
                        Selecione um cliente
                    </option>

                </select>

                <span asp-validation-for="ClienteId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VeiculoId" class="control-label">
                    Veículo
                </label>

                <select asp-for="VeiculoId"
                        asp-items="ViewBag.Veiculos"
                        class="form-control">

                    <option value="">
                        Selecione um veículo
                    </option>

                </select>

                <span asp-validation-for="VeiculoId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">
                    Preço Estimado
                </label>

                @* in Views/Reservas/Create.cshtml *@
                <input class="form-control"
       value="@(Model == null ? "0.00 €" : Model.PrecoEstimado.ToString("0.00") + " €")"
       readonly />
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Criar Reserva"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Voltar à Lista
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}