@model Projeto_AutoMobile.Data.Projeto_AutoMobile.Reserva

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar Reserva</h1>

<h3>Tem a certeza que pretende eliminar esta reserva?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente.Nome</dd>

    <dt class="col-sm-3">Veículo</dt>
    <dd class="col-sm-9">@Model.Veiculo.Id</dd>

    <dt class="col-sm-3">Data Início</dt>
    <dd class="col-sm-9">@Model.DataInicio.ToShortDateString()</dd>

    <dt class="col-sm-3">Data Fim</dt>
    <dd class="col-sm-9">@Model.DataFim.ToShortDateString()</dd>

    <dt class="col-sm-3">Preço Total</dt>
    <dd class="col-sm-9">@Model.PrecoEstimado €</dd>

</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <input type="submit"
           value="Eliminar"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>