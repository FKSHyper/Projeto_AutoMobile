@{
    ViewData["Title"] = "Faturação entre Datas";
}

<h1>Faturação entre Datas</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Faturacao" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label>Data de Início</label>
                <input type="date" name="dataInicio" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Data de Fim</label>
                <input type="date" name="dataFim" class="form-control" />
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Calcular"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

@if (ViewBag.TotalFaturacao != null)
{
    <div class="alert alert-info mt-4">
        Valor total faturado entre
        <strong>@ViewBag.DataInicio.ToString("dd/MM/yyyy")</strong>
        e
        <strong>@ViewBag.DataFim.ToString("dd/MM/yyyy")</strong>:

        <br />

        <strong>@ViewBag.TotalFaturacao.ToString("0.00") €</strong>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Voltar às Reservas
    </a>
</div>