@{
    ViewData["Title"] = "Faturação entre Datas";

    // MAGIA AQUI: Recuperar as datas para preencher os inputs e evitar que fiquem em branco!
    string dataInicioVal = ViewBag.DataInicio != null ? ((DateTime)ViewBag.DataInicio).ToString("yyyy-MM-dd") : "";
    string dataFimVal = ViewBag.DataFim != null ? ((DateTime)ViewBag.DataFim).ToString("yyyy-MM-dd") : "";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Projeto_AutoMobile.styles.css" asp-append-version="true" />

<div class="container-fluid custom-container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-graph-up-arrow"></i> Relatório de Faturação</h3>
    </div>

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm custom-card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-calendar-range me-2"></i> Período de Faturação</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Faturacao" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Data de Início</label>
                            <input type="date" name="dataInicio" class="form-control" value="@dataInicioVal" required />
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Data de Fim</label>
                            <input type="date" name="dataFim" class="form-control" value="@dataFimVal" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-calculator"></i> Calcular Faturação
                            </button>
                            <a asp-action="Index" class="btn btn-theme-menu">
                                Voltar às Reservas
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @if (ViewBag.TotalFaturacao != null)
        {
            <div class="col-md-7 mb-4">
                <div class="card shadow-sm custom-card h-100" style="border-color: #52b788 !important;">
                    <div class="card-header" style="background-color: #52b788; color: white;">
                        <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i> Resultado da Faturação</h5>
                    </div>
                    <div class="card-body p-5 d-flex flex-column justify-content-center align-items-center text-center">
                        <p class="text-muted fs-5 mb-2">Valor total faturado entre</p>
                        <h5 class="fw-bold mb-4">
                            @ViewBag.DataInicio.ToString("dd/MM/yyyy") e @ViewBag.DataFim.ToString("dd/MM/yyyy")
                        </h5>

                        <h1 class="display-3 fw-bold" style="color: #52b788;">
                            @ViewBag.TotalFaturacao.ToString("0.00") €
                        </h1>
                    </div>
                </div>
            </div>
        }
    </div>
</div>