@model dynamic
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Projeto_AutoMobile.styles.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<div class="btn-group btn-actions-group" role="group">
    <a asp-action="Edit" asp-route-id="@Model" class="btn btn-table-action action-edit" title="Editar">
        <i class="bi bi-pencil-square"></i>
    </a>
    @* <a asp-action="Details" asp-route-id="@Model" class="btn btn-table-action action-details" title="Detalhes">
        <i class="bi bi-info-circle"></i>
    </a> *@
    <a asp-action="Index" asp-route-idToDelete="@Model" class="btn btn-table-action action-delete" title="Apagar">
        <i class="bi bi-trash3"></i>
    </a>
</div>