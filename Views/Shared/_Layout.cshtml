<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projeto_AutoMobile</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Projeto_AutoMobile.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="../Views/Shared/_Layout.cshtml.css" />
</head>
@functions {
        string IsActive(string controller)
        {
                var current = ViewContext.RouteData.Values["controller"]?.ToString();
                return string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
        }
}
<body style="display: flex; flex-direction: column; min-height: 100vh; margin: 0;">
    <input type="checkbox" id="sidebar-toggle" class="d-none">

    <div class="wrapper">
        <div class="hover-trigger"></div>
        <nav id="sidebar" class="border-end vh-100 p-3 shadow d-flex flex-column" style=" width:200px;">
            <div>
                <label for="sidebar-toggle" class="btn btn-sm btn-outline-secondary float-end perm-toggle">
                    <span class="perm">👁️</span>
                    <span class="not-perm">🙈</span>
                </label>
                <h4 class="text-nowrap">Menu</h4>
            </div>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 text-nowrap @IsActive("Home")" asp-controller="Home" asp-action="Index">
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 text-nowrap @IsActive("Clientes")" asp-controller="Clientes" asp-action="Index">
                        Clientes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 text-nowrap @IsActive("Reservas")" asp-controller="Reservas" asp-action="Index">
                        Reservas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 text-nowrap @IsActive("Carros")" asp-controller="Carros" asp-action="Index">
                        Carros
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 text-nowrap @IsActive(" Motas")" asp-controller="Motas" asp-action="Index">
                        Motas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 text-nowrap @IsActive("Camioes")" asp-controller="Camioes" asp-action="Index">
                        Camiões
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 text-nowrap @IsActive("Camionetas")" asp-controller="Camionetas" asp-action="Index">
                        Camionetas
                    </a>
                </li>
            </ul>
        </nav>

        <main class="p-4 flex-grow-1">
            <div class="d-flex w-100 justify-content-sm-between">
                <label for="sidebar-toggle" class="btn btn-theme-menu">☰ Menu</label>
                <li class="me-3 d-flex align-items-center" style="list-style: none;">
                    <div class="form-check form-switch mb-0" title="Mudar Tema">
                        <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch" style="cursor: pointer;">

                        <label class="form-check-label ms-1" for="themeSwitch" id="themeLabel" style="cursor: pointer;">
                            ☼
                        </label>
                    </div>
                </li>
            </div>
            
            @RenderBody()
        </main>
    </div>
    <footer class="border-top">
        <div class="d-flex flex-column align-items-start small p-2 footer-text">
            <div class="fw-bold text-nowrap">Trabalho do Grupo 1:</div>
            <div class="text-nowrap">Rafael, João R., Leonor , Madalena, Martim</div>
        </div>
    </footer>
    <script>
        const themeSwitch = document.getElementById('themeSwitch');
        const themeLabel = document.getElementById('themeLabel');
        const htmlElement = document.documentElement;

        //Qunado mudamos o botao do tema, grava a escolha
        const savedTheme = localStorage.getItem('theme'); //Verifica se tem algum 'bilhete' guardado

        if (savedTheme === 'dark') {
            htmlElement.setAttribute('data-theme', 'dark');
            themeSwitch.checked = true; // Garante que o botão deslizante está ligado
            themeLabel.innerText = '☾';
        }
        // Fica à espera que o botão deslize
        themeSwitch.addEventListener('change', function () {

            // Se o botão estiver ligado (checked)...
            if (this.checked) {
                // 1. Ativa o Modo Escuro no teu CSS
                document.documentElement.setAttribute('data-theme', 'dark');
                // 2. Troca o ícone para a Lua
                themeLabel.innerHTML = '☾';
                localStorage.setItem('theme', 'dark'); //Cria um 'bilhete' theme com o valor 'dark'
            }
            // Se o botão for desligado...
            else {
                // 1. Desliga o Modo Escuro (volta ao Claro)
                document.documentElement.setAttribute('data-theme', 'light');
                // 2. Troca o ícone para o Sol
                themeLabel.innerHTML = '☼';
                localStorage.setItem('theme', 'light');
            }
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
