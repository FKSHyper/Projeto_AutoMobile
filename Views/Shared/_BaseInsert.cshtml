@{
    Layout = "_Layout"; // O layout base com sidebar e cores
}

<div class="custom-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">@ViewData["Titulo"]</h2>
        <a asp-action="Index" class="btn btn-theme-menu d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> <span>Voltar à Lista</span>
        </a>
    </div>

    @RenderBody()
</div>

@RenderSection("Scripts", required: false)
