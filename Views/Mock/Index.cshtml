@model IEnumerable<Projeto_AutoMobile.Data.Projeto_AutoMobile.Cliente>

@{
    var selectedId = ViewBag.SelectedId as int?;
    var selectedCliente = Model.FirstOrDefault(c => c.Id == selectedId);
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Projeto_AutoMobile.styles.css" asp-append-version="true" />
<link rel="stylesheet" href="../Views/Shared/_Layout.cshtml.css" />
<div class="container-fluid custom-container">
    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm custom-card">
                <div class="card-header">
                    <h5 class="mb-0">Informações Detalhadas</h5>
                </div>
                <div class="card-body p-0" style="min-height: 300px;">
                    @if (selectedCliente != null)
                    {
                        <ul class="details-list">
                            <li><strong>Nome:</strong> @selectedCliente.Nome</li>
                            <li><strong>NIF:</strong> @selectedCliente.NIF</li>
                            <li><strong>Email:</strong> @selectedCliente.Email</li>
                            <li><strong>Telemóvel:</strong> @selectedCliente.Telemovel</li>
                            <li><strong>Carta:</strong> @selectedCliente.CartaConducao</li>
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <p>Selecione um cliente na lista ao lado para ver os detalhes.</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm custom-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Lista de Clientes</h5>
                    <a asp-action="Create" class="btn btn-sm btn-primary">Novo Cliente</a>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover custom-table mb-0">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>NIF</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string activeClass = (item.Id == selectedId) ? "table-selected" : "";

                                <tr class="@activeClass cursor-pointer" onclick="location.href='@Url.Action("Index", "Mock", new { id = item.Id })'">
                                    <td>@item.Nome</td>
                                    <td>@item.NIF</td>
                                    <td class="text-end action-cell" onclick="event.stopPropagation();">
                                        <partial name="_TabelaAcoes" model="item.Id" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="card-footer">
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>