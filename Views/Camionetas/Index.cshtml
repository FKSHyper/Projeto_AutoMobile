@model IEnumerable<Projeto_AutoMobile.Data.Projeto_AutoMobile.Camioneta>

@{
    Layout = "_BaseIndex";
    ViewData["Title"] = "Camionetas";
    ViewData["DetalhesTitulo"] = "Informações Detalhadas";
    ViewData["ListaTitulo"] = "Lista de Camionetas";

    var selectedId = ViewBag.SelectedId as int?;
    var selectedCamioneta = Model.FirstOrDefault(c => c.Id == selectedId);
}

@section Detalhes {
    @if (selectedCamioneta != null)
    {
        <ul class="details-list">
            <li><strong>Matrícula:</strong>@selectedCamioneta.Matricula</li>
            <li><strong>Estado:</strong>@selectedCamioneta.Estado</li>
            <li><strong>Preço/Dia:</strong>@selectedCamioneta.PrecoDia.ToString("C")</li>
            <li><strong>Nrº. Passageiros:</strong>@selectedCamioneta.MaxPassageiros</li>
            <li><strong>Eixos:</strong>@selectedCamioneta.Eixos</li>
            <li><strong>Disponibilidade:</strong>@selectedCamioneta.DataDisponibilidade</li>
        </ul>
    }
    else
    {
        <div class="text-center py-5">
            <p>Selecione uma camioneta da lista para ver os detalhes completos.</p>
        </div>
    }
}
<table class="table table-hover custom-table mb-0">
    <thead>
        <tr>
            <th>Matrícula</th>
            <th>Marca / Modelo</th>
            <th>Nrº. Passageiros</th>
            <th>Eixos</th>
            <th>Preço/Dia</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string activeClass = (item.Id == selectedId) ? "table-selected" : "";

            <tr class="@activeClass cursor-pointer" onclick="location.href='@Url.Action("Index", "Camionetas", new { id = item.Id })'">
                <td>@item.Matricula</td>
                <td>@item.Marca @item.Modelo</td>
                <td>@item.MaxPassageiros</td>
                <td>@item.Eixos</td>
                <td>@item.PrecoDia.ToString("C")</td>
                <td class="text-end action-cell" onclick="event.stopPropagation();">
                    <partial name="_TabelaAcoes" model="item.Id" />
                </td>
            </tr>
        }
    </tbody>
</table>