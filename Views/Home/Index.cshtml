@model Projeto_AutoMobile.ViewModels.Veiculos.VeiculosDisponiveisViewModel

@{
    ViewData["Title"] = "Dashboard - Frota";
    DateTime dataAtual = Model.DataAtual;
    var alarmes = ViewBag.Alarmes as List<string>;
}

@if (alarmes != null && alarmes.Any())
{
    <div class="d-flex justify-content-center mt-3">
        <div class="alert alert-danger shadow-lg border-3 w-75">
            <h4 class="alert-heading text-center">🚨 Veículos com Prazo Expirado (@alarmes.Count)</h4>
            <hr>
            <ul class="mb-0" style="max-height: 200px; overflow-y: auto;">
                @foreach (var alarme in alarmes)
                {
                    <li class="fw-bold mb-1">@alarme</li>
                }
            </ul>
        </div>
    </div>
}

<hr class="my-5">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Projeto_AutoMobile.styles.css" asp-append-version="true" />
<link rel="stylesheet" href="../Views/Shared/_Layout.cshtml.css" />

<div class="container-fluid custom-container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-car-front"></i> Gestão de Frota</h3>
        <div class="row">
            <form asp-controller="Home" asp-action="AtualizarDataSimulador" method="post" id="dateForm">

                <div class="p-2 fs-6 text-end">
                    <i class="bi bi-calendar3"></i> Data do Simulador:
                    <span id="displayDate" class="fw-bold fs-5 text-primary">@dataAtual.ToShortDateString()</span>
                </div>

                <div class="btn-group shadow-sm mt-2" role="group">
                    <button type="button" class="btn btn-secondary" onclick="changeDate(-1)">⏪ Recuar o Dia</button>
                    <button type="button" class="btn btn-warning fw-bold" onclick="changeDate(1)">Avançar o Dia ⏳</button>
                </div>

                <input type="hidden" id="hiddenDataAtual" name="dataAtual" value="@dataAtual.ToString("yyyy-MM-dd")" />
            </form>

            <script>
                // Initialize JS Date with Server Date
                let currentDate = new Date('@dataAtual.ToString("yyyy-MM-ddTHH:mm:ss")');

                function changeDate(daysToAdd) {
                    // Change the date
                    currentDate.setDate(currentDate.getDate() + daysToAdd);

                    // Format as yyyy-MM-dd for C#
                    const year = currentDate.getFullYear();
                    const month = String(currentDate.getMonth() + 1).padStart(2, '0');
                    const day = String(currentDate.getDate()).padStart(2, '0');

                    // Update hidden input
                    document.getElementById('hiddenDataAtual').value = `${year}-${month}-${day}`;

                    // Auto-submit the form to the Controller immediately
                    document.getElementById('dateForm').submit();
                }
            </script>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm custom-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Lista de Veículos</h5>
                </div>

                <div class="card-body p-0">
                    <table class="table table-hover custom-table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Matrícula</th>
                                <th>Marca / Modelo</th>
                                <th>Preço / Dia</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Veiculos.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Ainda não há veículos registados.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Veiculos)
                                {
                                    string badgeColor = item.Estado switch
                                    {
                                        Projeto_AutoMobile.Data.Projeto_AutoMobile.EstadoVeiculo.Disponivel => "bg-success",
                                        Projeto_AutoMobile.Data.Projeto_AutoMobile.EstadoVeiculo.Alugado => "bg-danger",
                                        Projeto_AutoMobile.Data.Projeto_AutoMobile.EstadoVeiculo.Reservado => "bg-warning text-dark",
                                        Projeto_AutoMobile.Data.Projeto_AutoMobile.EstadoVeiculo.EmManutencao => "bg-secondary",
                                        _ => "bg-dark"
                                    };

                                    <tr>
                                        <td class="text-muted fw-bold">@item.GetType().Name</td>
                                        <td class="text-uppercase">@item.Matricula</td>
                                        <td>@item.Marca @item.Modelo</td>
                                        <td class="fw-bold">@item.PrecoDia.ToString("C")</td>
                                        <td><span class="badge @badgeColor">@Html.DisplayFor(m => item.Estado)</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="card-footer">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
