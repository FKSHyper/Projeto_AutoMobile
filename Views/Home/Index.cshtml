@model Projeto_AutoMobile.ViewModels.Veiculos.VeiculosDisponiveisViewModel

@{
    ViewData["Title"] = "Dashboard - Frota";
    DateTime dataAtual = Model.DataAtual;
    var alarmes = ViewBag.Alarmes as List<string>;

    // Recuperar com segurança as reservas que vêm da ViewBag do HomeController
    var reservas = ViewBag.TodasReservas as List<Projeto_AutoMobile.Data.Projeto_AutoMobile.Reserva>
                   ?? new List<Projeto_AutoMobile.Data.Projeto_AutoMobile.Reserva>();
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Projeto_AutoMobile.styles.css" asp-append-version="true" />
<link rel="stylesheet" href="../Views/Shared/_Layout.cshtml.css" />

@if (alarmes != null && alarmes.Any())
{
    <div class="d-flex justify-content-center mt-3">
        <div class="alert alert-danger shadow-lg border-3 w-75">
            <h4 class="alert-heading text-center">🚨 Veículos com Prazo Expirado (@alarmes.Count)</h4>
            <hr>
            <ul class="mb-0" style="max-height: 200px; overflow-y: auto;">
                @foreach (var alarme in alarmes)
                {
                    <li class="fw-bold mb-1">@alarme</li>
                }
            </ul>
        </div>
    </div>
    <hr class="my-5">
}

<div class="container-fluid custom-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-car-front"></i> Gestão de Frota</h3>
        <div class="row">
            <form asp-controller="Home" asp-action="AtualizarDataSimulador" method="post" id="dateForm">

                <div class="p-2 fs-6 text-end">
                    <i class="bi bi-calendar3"></i> Data do Simulador:
                    <span id="displayDate">@dataAtual.ToShortDateString()</span>
                </div>

                <div class="btn-group shadow-sm mt-2" role="group">
                    <button type="button" class="btn btn-theme-menu" onclick="changeDate(-1)">⏪ Recuar o Dia</button>
                    <button type="button" class="btn btn-theme-menu" onclick="changeDate(1)">Avançar o Dia ⏳</button>
                </div>

                <input type="hidden" id="hiddenDataAtual" name="dataAtual" value="@dataAtual.ToString("yyyy-MM-dd")" />
            </form>

            <script>
                // Initialize JS Date with Server Date
                let currentDate = new Date('@dataAtual.ToString("yyyy-MM-ddTHH:mm:ss")');

                function changeDate(daysToAdd) {
                    // Change the date
                    currentDate.setDate(currentDate.getDate() + daysToAdd);
                    // Format as yyyy-MM-dd for C#
                    const year = currentDate.getFullYear();
                    const month = String(currentDate.getMonth() + 1).padStart(2, '0');
                    const day = String(currentDate.getDate()).padStart(2, '0');
                    // Update hidden input
                    document.getElementById('hiddenDataAtual').value = `${year}-${month}-${day}`;
                    // Auto-submit the form to the Controller immediately
                    document.getElementById('dateForm').submit();
                }
            </script>
        </div>
    </div>
    <div class="custom-card py-3 px-5">
        <form asp-action="index" method="get" class="row align-items-end">
            <input type="hidden" name="data" value="@Model.DataAtual.ToString("yyyy-MM-dd")" />
            <div class="col-md-4">
                <label class="fw-bold mb-1">Tipo de Veículo:</label>
                <select name="tipoSelecionado" class="form-select">
                    <option value="Todos" selected="@(Model.TipoSelecionado == "Todos")">Mostrar Todos</option>
                    <option value="Carro" selected="@(Model.TipoSelecionado == "Carro")">Carros</option>
                    <option value="Mota" selected="@(Model.TipoSelecionado == "Mota")">Motas</option>
                    <option value="Camioneta" selected="@(Model.TipoSelecionado == "Camioneta")">Camionetas</option>
                    <option value="Camiao" selected="@(Model.TipoSelecionado == "Camiao")">Camiões</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="fw-bold mb-1">Estado do Veículo:</label>
                <select name="estadoSelecionado" class="form-select">
                    <option value="Todos" selected="@(Model.EstadoSelecionado == "Todos")">Qualquer Estado</option>
                    <option value="Disponivel" selected="@(Model.EstadoSelecionado == "Disponivel")">Disponíveis</option>
                    <option value="Alugado" selected="@(Model.EstadoSelecionado == "Alugado")">Alugados</option>
                    <option value="Reservado" selected="@(Model.EstadoSelecionado == "Reservado")">Reservados</option>
                    <option value="EmManutencao" selected="@(Model.EstadoSelecionado == "EmManutencao")">Em Manutenção</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-funnel"></i> Aplicar Filtros
                </button>
            </div>
            <div class="col-md-2">
                <button asp-controller="Home" asp-action="ExportarCSV" class="btn btn-primary w-100 fw-bold">
                    <i class="fas fa-file-csv"></i> Exportar Frota (CSV)
                </button>
            </div>
        </form>
    </div>

    <div class="card shadow-sm custom-card">
        <div class="card-body p-0">
            <table class="table table-hover custom-table mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID / Matrícula</th>
                        <th>Tipo / Modelo</th>
                        <th>Estado Oficial</th>
                        <th>Status Real (Simulador)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Veiculos.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Nenhum veículo encontrado.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var veiculo in Model.Veiculos)
                        {
                            // 1. Filtrar as reservas deste veículo específico
                            var reservasDoVeiculo = reservas.Where(r => r.VeiculoId == veiculo.Id).ToList();

                            // O veículo entra em modo Alugado logo a partir da DataInicio
                            var reservaAtivaHoje = reservasDoVeiculo.FirstOrDefault(r => Model.DataAtual.Date >= r.DataInicio.Date);

                            string estadoOficialTexto;
                            string badgeColor;
                            string statusRealTexto;

                            // Se o veículo estiver em manutenção forçada na BD, respeitamos prioritariamente
                            if (veiculo.Estado == Projeto_AutoMobile.Data.Projeto_AutoMobile.EstadoVeiculo.EmManutencao)
                            {
                                estadoOficialTexto = "Em Manutenção";
                                badgeColor = "bg-warning text-dark";
                                statusRealTexto = veiculo.DataDisponibilidade.HasValue
                                ? $"Em reparação até {veiculo.DataDisponibilidade.Value.ToString("dd/MM/yyyy")}"
                                : "Manutenção por tempo indeterminado";
                            }
                            else if (reservaAtivaHoje != null)
                            {
                                // Reserva ativa hoje
                                estadoOficialTexto = "Alugado";
                                badgeColor = "bg-danger";
                                statusRealTexto = $"Alugado de {reservaAtivaHoje.DataInicio.ToString("dd/MM/yyyy")} a {reservaAtivaHoje.DataFim.ToString("dd/MM/yyyy")}";
                            }
                            else
                            {
                                // Não tem reserva hoje (Está Disponível)
                                estadoOficialTexto = "Disponível";
                                badgeColor = "bg-success";

                                // Procurar se existe alguma reserva agendada para o futuro
                                var proximaReservaFutura = reservasDoVeiculo
                                .Where(r => r.DataInicio.Date > Model.DataAtual.Date)
                                .OrderBy(r => r.DataInicio)
                                .FirstOrDefault();

                                if (proximaReservaFutura != null)
                                {
                                    statusRealTexto = $"Próxima reserva: {proximaReservaFutura.DataInicio.ToString("dd/MM/yyyy")}";
                                }
                                else
                                {
                                    statusRealTexto = "Pronto a reservar";
                                }
                            }

                            <tr>
                                <td class="fw-bold">@veiculo.Id / <span class="text-uppercase">@veiculo.Matricula</span></td>
                                <td>
                                    <small class="text-muted d-block">@veiculo.GetType().Name</small>
                                    @veiculo.Marca @veiculo.Modelo
                                </td>
                                <td>
                                    <span class="badge @badgeColor">@estadoOficialTexto</span>
                                </td>
                                <td>
                                    <small class="text-muted"><em>@statusRealTexto</em></small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer"></div>
    </div>
</div>