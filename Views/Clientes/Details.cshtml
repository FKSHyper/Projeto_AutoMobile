@model Projeto_AutoMobile.Data.Projeto_AutoMobile.Cliente

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes do Cliente</h1>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>

        <dt class="col-sm-3">NIF</dt>
        <dd class="col-sm-9">@Model.NIF</dd>

        <dt class="col-sm-3">Carta de Condução</dt>
        <dd class="col-sm-9">@Model.CartaConducao</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Telemóvel</dt>
        <dd class="col-sm-9">@Model.Telemovel</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Voltar à Lista</a>
</div>